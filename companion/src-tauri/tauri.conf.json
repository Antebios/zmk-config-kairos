{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairos44 Companion",
  "version": "0.1.0",
  "identifier": "dev.kairos.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairos44 Companion",
        "width": 1000,
        "height": 780,
        "minWidth": 360,
        "minHeight": 240,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Floating Kairos44 keyboard layer and shortcut viewer",
    "longDescription": "A floating window that shows the Kairos44 keyboard's layers, key types, gestures and combos, and follows the layer the keyboard is on over USB.",
    "linux": {
      "deb": {
        "depends": ["libudev1"],
        "files": {
          "/usr/lib/udev/rules.d/70-kairos44-companion.rules": "../contrib/udev/70-kairos44-companion.rules"
        }
      },
      "rpm": {
        "depends": ["systemd-libs"],
        "files": {
          "/usr/lib/udev/rules.d/70-kairos44-companion.rules": "../contrib/udev/70-kairos44-companion.rules"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Kairos44"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}