{
  "name": "kairos44-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "build:bin": "tauri build --no-bundle",
    "build:app": "tauri build",
    "app:build": "node scripts/app.mjs build",
    "app:install": "node scripts/app.mjs install",
    "app:uninstall": "node scripts/app.mjs uninstall",
    "app:start": "node scripts/app.mjs start",
    "app:kill": "node scripts/app.mjs kill",
    "package": "node scripts/app.mjs package",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm run test && npm run test:rust",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run test:all && npm run check:rust",
    "audit": "npm audit",
    "keymap:generate": "node scripts/keymap.mjs generate",
    "keymap:check": "node scripts/keymap.mjs check",
    "docs:reference": "vitest run src/reference.test.ts -u",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict",
    "clean": "node -e \"for (const d of ['dist','site']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "clean:rust": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "marked": "^18.1.2",
    "solid-js": "^1.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.2",
    "typescript": "~5.9",
    "vite": "^7",
    "vite-plugin-solid": "^2.11",
    "vitest": "^5"
  }
}
