# Builds the companion app from this checkout, for Arch Linux and Omarchy:
#   cd companion/packaging/arch && makepkg -f
#   sudo pacman -U kairos44-companion-*.pkg.tar.zst
# The package installs the udev rule, so no separate sudo step is needed to read the keyboard.
pkgname=kairos44-companion
pkgver=0.1.0
pkgrel=1
pkgdesc="Floating Kairos44 keyboard layer and shortcut viewer"
arch=('x86_64')
url="https://gitlab.cosmiklab.com/home/zmk-config-kairos"
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'libayatana-appindicator' 'systemd-libs')
makedepends=('rust' 'nodejs' 'npm')
options=('!lto' '!debug')

# The source is the surrounding checkout, so there is nothing to download or verify.
_root="$startdir/../.."

build() {
  cd "$_root"
  npm ci
  npm run tauri -- build --no-bundle
}

package() {
  cd "$_root"
  install -Dm755 src-tauri/target/release/kairos44-companion \
    "$pkgdir/usr/bin/kairos44-companion"
  install -Dm644 contrib/udev/70-kairos44-companion.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-kairos44-companion.rules"
  install -Dm644 packaging/kairos44-companion.desktop \
    "$pkgdir/usr/share/applications/kairos44-companion.desktop"
  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/kairos44-companion.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/kairos44-companion.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/kairos44-companion.png"
}
