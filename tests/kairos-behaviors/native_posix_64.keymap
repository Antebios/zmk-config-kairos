#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <behaviors.dtsi>
#include "../../boards/shields/common/kairos/helpers/layers.keymap"
#include "../../boards/shields/common/kairos/helpers/macros_include.keymap"
#include "../../boards/shields/common/kairos/helpers/timings.keymap"

#define TEST_LAYER(KEY) &kp KEY &trans &trans &trans &trans &trans &trans &trans

/ {
    behaviors {
        #include "../../boards/shields/common/kairos/helpers/tap_dance.keymap"
    };

    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <&kp B &ht LSHIFT F tdLower() tdRaise()
                        tdDown() tdUp() &kp ENTER tdLeftSpace()>;
        };
        navigation {
            bindings = <&kp C &trans &trans &trans
                        &trans &trans &to UTILS &trans>;
        };
        functions { bindings = <TEST_LAYER(D)>; };
        symbols { bindings = <TEST_LAYER(E)>; };
        utils {
            bindings = <&kp G &trans &trans &trans
                        &trans &trans &sl NAVIGATION &to BASE>;
        };
        mirror { bindings = <TEST_LAYER(H)>; };
        combos { bindings = <TEST_LAYER(I)>; };
    };
};

&kscan {
    rows = <2>;
    columns = <4>;
    events = <
        ZMK_MOCK_PRESS(0,2,1)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,1)
        ZMK_MOCK_RELEASE(0,2,1)
        ZMK_MOCK_PRESS(0,3,1)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,3,1)
        ZMK_MOCK_RELEASE(0,0,1)
        ZMK_MOCK_PRESS(1,0,1)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,1)
        ZMK_MOCK_RELEASE(1,0,1)
        ZMK_MOCK_PRESS(1,1,1)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,1)
        ZMK_MOCK_RELEASE(1,1,250)
        ZMK_MOCK_PRESS(0,1,190)
        ZMK_MOCK_RELEASE(0,1,250)
        ZMK_MOCK_PRESS(0,1,210)
        ZMK_MOCK_RELEASE(0,1,250)
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,1,250)
        ZMK_MOCK_RELEASE(0,1,250)
        ZMK_MOCK_PRESS(1,3,210)
        ZMK_MOCK_RELEASE(1,3,300)
        ZMK_MOCK_PRESS(1,3,230)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,1)
        ZMK_MOCK_RELEASE(1,3,300)
        ZMK_MOCK_PRESS(0,2,1)
        ZMK_MOCK_PRESS(1,2,1)
        ZMK_MOCK_RELEASE(1,2,1)
        ZMK_MOCK_RELEASE(0,2,1)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,100)
        ZMK_MOCK_PRESS(1,3,1)
        ZMK_MOCK_RELEASE(1,3,1)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,1)
        ZMK_MOCK_PRESS(1,1,1)
        ZMK_MOCK_PRESS(1,2,1)
        ZMK_MOCK_RELEASE(1,2,1)
        ZMK_MOCK_RELEASE(1,1,1)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,1)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,100)
    >;
};
